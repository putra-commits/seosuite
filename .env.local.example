# AdoloSEO — contoh konfigurasi lokal.
# Salin jadi .env.local. JANGAN commit .env.local.
#
# Di produksi (VPS Bigcloud) nilai-nilai ini ada di /opt/bigcloud/seosuite/.env
# dengan izin 600 — BUKAN Doppler. Workspace Doppler sudah mentok batas 10
# project, jadi AdoloSEO tidak bisa mendapat project sendiri. PM2 menjalankan
# `next start` langsung, dan Next.js membaca .env dari cwd saat runtime.

# ── Wajib untuk konsol admin ────────────────────────────────────────────────
# Token pembuka /admin/leads dan /api/leads. Kalau kosong, konsol admin
# menolak SEMUA akses (fail closed) — disengaja: lebih baik admin terkunci
# daripada nomor WhatsApp prospek bocor ke publik.
ADMIN_TOKEN=

# ── Opsional ────────────────────────────────────────────────────────────────
# Verdict naratif di laporan audit. Kosong = laporan tetap terbit tanpa
# "Catatan Konsultan".
ANTHROPIC_API_KEY=
VERDICT_MODEL=claude-haiku-4-5-20251001

# Data Core Web Vitals asli dari PageSpeed Insights. Kosong = pakai heuristik.
PSI_API_KEY=

# Lokasi penyimpanan laporan & database prospek.
# Kosong = <folder app>/data — TIDAK AMAN di produksi: seluruh lead lenyap
# begitu folder deploy diganti. Di VPS arahkan ke volume di luar folder rilis,
# misalnya /var/lib/adoloseo/data
ADOLOSEO_DATA_DIR=
